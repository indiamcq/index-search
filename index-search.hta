<!DOCTYPE html>
<html>
    <head>
        <title>Index Search</title>
        <hta:application id="IndexSearch" singleinstance="yes" ICON="index.ico"/>
        <link rel="stylesheet" href="index-search.css"/>
        <script type="text/vbscript" src="index-search.vbs"></script>
        <meta version="2.0"/>
    </head>
    <body>
        <!--<h3 id="apptitle"></h3>-->
        <div id="main" class="tabcontent active">
            <h4 id="h4">Search </h4>
            <div id="contain">
                <div id="col1">
                    <form name="myTarget">
                        <p>Where to Search:</p>
                        <ul id="groups">
                            <li id="labela"></li>
                            <li id="labelb"></li>
                            <li id="labelc"></li>
                            <li id="labeld"></li>
                            <li id="labele"></li>
                            <li id="labelf"></li>
                            <li id="labelg"></li>
                            <li id="labelh"></li>
                            <li id="labeli"></li>
                            <li id="labelj"></li>
                            <li id="labelk"></li>
                            <li id="labell"></li>
                            <li id="labelm"></li>
                            <li id="labeln"></li>
                            <li id="labelo"></li>
                            <li id="labelp"></li>
                            <li id="labelq"></li>
                            <li id="labelr"></li>
                            <li id="labels"></li>
                            <li id="labelt"></li>
                            <li id="labelu"></li>
                            <li id="labelv"></li>
                            <li id="labelw"></li>
                            <li id="labelx"></li>
                            <li id="labely"></li>
                            <li id="labelz"></li>
                        </ul>
                    </form>
                </div>
                <div id="col2">
                    <form name="searchType">
                        <p>Select what type of Search:</p>
                        <ul id="types">
                            <li id="phrase"></li>
                            <li id="multi"></li>
                            <li id="regex"></li>
                        </ul>
                    </form>
                    <form name="formatType">
                        <p>Select output type:</p>
                        <ul id="format">
                            <li id="table"></li>
                            <li id="para"></li>
                            <li id="list"></li>
                        </ul>
                    </form>
                </div>
            </div>
            <p>
                <input type="text" id="stringSearch" style="width: 300px;"/>
                <button onclick="FindString()">Search</button>
            </p>
        </div>
        <!-- <p id="bug1"></p>
        <p id="bug2"></p>
        <p id="bug3"></p> -->
    </body>
</html>
