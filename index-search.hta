<!DOCTYPE html>
<html>
    <head>
        <title>Index Search</title>
        <hta:application id="IndexSearch" singleinstance="yes" ICON="index.ico"/>
        <link rel="stylesheet" href="search.css"/>
        <script type="text/vbscript" src="search.vbs"></script>
        <meta version="2.0"/>
    </head>
    <body>
        <!--<h3 id="apptitle"></h3>-->
        <div id="main" class="tabcontent active">
            <h4 id="h4">Search </h4>
            <table>
                <tr>
                    <td width="40%">
                        <form name="myGroup">
                            <p>Where to Search:</p>
                            <table>
                                <tr>
                                    <td>
                                        <input id="radioa" type="radio" name="group" value="a" checked=""/>
                                    </td>
                                    <td id="labela"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radiob" type="radio" name="group" value="b"/>
                                    </td>
                                    <td id="labelb"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radioc" type="radio" name="group" value="c"/>
                                    </td>
                                    <td id="labelc"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radiod" type="radio" name="group" value="d"/>
                                    </td>
                                    <td id="labeld"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radioe" type="radio" name="group" value="e"/>
                                    </td>
                                    <td id="labele"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radiof" type="radio" name="group" value="f"/>
                                    </td>
                                    <td id="labelf"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radiog" type="radio" name="group" value="g"/>
                                    </td>
                                    <td id="labelg"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radioh" type="radio" name="group" value="h"/>
                                    </td>
                                    <td id="labelh"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radioi" type="radio" name="group" value="i"/>
                                    </td>
                                    <td id="labeli"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radioj" type="radio" name="group" value="j"/>
                                    </td>
                                    <td id="labelj"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radiok" type="radio" name="group" value="k"/>
                                    </td>
                                    <td id="labelk"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radiol" type="radio" name="group" value="l"/>
                                    </td>
                                    <td id="labell"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radiom" type="radio" name="group" value="m"/>
                                    </td>
                                    <td id="labelm"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radion" type="radio" name="group" value="n"/>
                                    </td>
                                    <td id="labeln"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radioo" type="radio" name="group" value="o"/>
                                    </td>
                                    <td id="labelo"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radiop" type="radio" name="group" value="p"/>
                                    </td>
                                    <td id="labelp"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radioq" type="radio" name="group" value="q"/>
                                    </td>
                                    <td id="labelq"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radior" type="radio" name="group" value="r"/>
                                    </td>
                                    <td id="labelr"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radios" type="radio" name="group" value="s"/>
                                    </td>
                                    <td id="labels"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radiot" type="radio" name="group" value="t"/>
                                    </td>
                                    <td id="labelt"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radiou" type="radio" name="group" value="u"/>
                                    </td>
                                    <td id="labelu"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radiov" type="radio" name="group" value="v"/>
                                    </td>
                                    <td id="labelv"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radiow" type="radio" name="group" value="w"/>
                                    </td>
                                    <td id="labelw"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radiox" type="radio" name="group" value="x"/>
                                    </td>
                                    <td id="labelx"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radioy" type="radio" name="group" value="y"/>
                                    </td>
                                    <td id="labely"></td>
                                </tr>
                                <tr>
                                    <td>
                                        <input id="radioz" type="radio" name="group" value="z"/>
                                    </td>
                                    <td id="labelz"></td>
                                </tr>
                            </table>
                        </form>
                    </td>
                    <td style="padding-left:2em;">
                        <form name="searchType">
        <p>Select what type of Search:</p>
        <input type="radio" name="type" value="phrase" checked= /> Word or phrase <br/>&#x2003;(case insensitive) search<br/>
        <input type="radio" name="type" value="multi"/> Non-contiguous word search<br/>
        <input type="radio" name="type" value="regex"/> Regular Expression search<br/>
    </form>
                        <form name="outputType">
<p>Select output type:</p>
        <input type="radio" name="out" value="table" checked= /> Table<br/>
        <input type="radio" name="out" value="para"/> In paragraphs with tags<br/>
</form>
                    </td>
                </tr>
            </table>
            <p>
                <input type="text" id="stringSearch" style="width: 300px;"/>
                <button onclick="FindString()">Search</button>
            </p>
        </div>
    </body>
</html>
